{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Container registry that holds the HOAS MCP server image. Deploy this first, then build the image into it."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for the registry." }
    },
    "acrName": {
      "type": "string",
      "defaultValue": "[format('hoasmcp{0}', uniqueString(resourceGroup().id))]",
      "minLength": 5,
      "maxLength": 50,
      "metadata": { "description": "Globally unique registry name (letters and digits only)." }
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[parameters('acrName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Basic" },
      "properties": {
        "adminUserEnabled": false
      }
    }
  ],
  "outputs": {
    "acrName": {
      "type": "string",
      "value": "[parameters('acrName')]"
    },
    "loginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))).loginServer]"
    }
  }
}
